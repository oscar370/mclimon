---
import TutorialArticle from "@/features/tutorials/components/tutorial-article.astro";
import TutorialsLayout from "@/features/tutorials/layouts/tutorials-layout.astro";
import { getTutorials } from "@/features/tutorials/services/get-tutorials";

export async function getStaticPaths() {
  const [, ...rest] = await getTutorials();

  return rest.map((tutorial) => ({
    params: { slug: tutorial.id },
    props: { tutorial },
  }));
}

const { tutorial } = Astro.props;
---

<TutorialsLayout currentId={tutorial.id}>
  <TutorialArticle tutorial={tutorial} />
</TutorialsLayout>
