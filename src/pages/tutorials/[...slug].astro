---
import TutorialsLayout from "@/features/tutorials/layouts/tutorials-layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const tutorials = await getCollection("tutorials", ({ data }) => !data.draft);
  return tutorials.map((tutorial) => ({
    params: { slug: tutorial.id },
    props: { tutorial },
  }));
}

const { tutorial } = Astro.props;
const { Content } = await render(tutorial);
---

<TutorialsLayout currentId={tutorial.id}>
  <article class="content">
    <h1>{tutorial.data.title}</h1>
    <Content />
  </article>
</TutorialsLayout>
